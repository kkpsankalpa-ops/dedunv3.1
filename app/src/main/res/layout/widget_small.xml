<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Custom Photo or Theme Synchronized Background -->
    <ImageView
        android:id="@+id/iv_small_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Fallback State -->
    <LinearLayout
        android:id="@+id/widget_small_fallback_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/widget_fallback_text"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Main Content State -->
    <LinearLayout
        android:id="@+id/widget_small_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="11dp">

        <!-- Header: Top-Left Circular Logo Badge & Top-Right Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_logo_badge_bg">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_app_logo"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_small_brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/app_name"
                android:textColor="@color/widget_gold_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_widget_settings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="3dp"
                android:src="@drawable/ic_widget_settings"
                android:contentDescription="Configure Widget" />
        </LinearLayout>

        <!-- Vertical Spacer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Vertical Block: Current Balance (Primary), Net Cash Flow Today, Safe to spend (Secondary) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_small_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_balance_label"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <!-- Primary Headline Number: Current Balance -->
            <TextView
                android:id="@+id/tv_small_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Rs. 0.00"
                android:textColor="@color/widget_gold_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Secondary Line: Net Cash Flow Today (+/- Rs. X today) -->
            <TextView
                android:id="@+id/tv_small_net_cash_flow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="+Rs. 0.00 today"
                android:textColor="#728C69"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Smaller Secondary Section: Safe to Spend -->
            <TextView
                android:id="@+id/tv_small_safe_to_spend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Safe: Rs. 0.00"
                android:textColor="@color/widget_text_muted"
                android:textSize="9.5sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
